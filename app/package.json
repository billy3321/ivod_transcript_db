{
  "name": "ivod-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:no-hmr": "node start-no-hmr.js",
    "build": "npm run clean && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --passWithNoTests --watch",
    "test:ci": "jest --runInBand --passWithNoTests",
    "test:summary": "node scripts/test-summary.js",
    "test:failures": "jest --passWithNoTests --verbose --runInBand --reporters=default",
    "test:video": "node scripts/test-summary.js VideoDownloader",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "prisma:prepare": "node scripts/updatePrismaSchema.js",
    "prisma:generate": "npm run prisma:prepare && prisma generate",
    "db:test": "node scripts/db-test.js",
    "es:test": "node scripts/es-test.js",
    "search:test": "node scripts/search-test.js",
    "search:interface:test": "node scripts/search-interface-test.js",
    "search:comprehensive:test": "node scripts/comprehensive-search-test.js",
    "clean": "rm -rf .next",
    "clean:all": "rm -rf .next node_modules/.cache .cache",
    "clean:hard": "rm -rf .next node_modules/.cache .cache && npm run prisma:generate",
    "fresh-start": "npm run clean:all && npm install && npm run prisma:generate"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.8.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@modelcontextprotocol/sdk": "^1.15.1",
    "@prisma/client": "^4.15.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@tanstack/react-query": "^5.77.0",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "autoprefixer": "^10.4.21",
    "axios": "^1.9.0",
    "bodybuilder": "^2.1.0",
    "dompurify": "^3.2.6",
    "dotenv": "^16.5.0",
    "hls.js": "^1.6.4",
    "js-yaml": "^4.1.0",
    "mysql2": "^3.14.1",
    "next": "^15.2.3",
    "pg": "^8.8.0",
    "prisma": "^4.15.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "search-query-parser": "^1.6.0",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^4.1.7",
    "typescript": "^4.9.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@types/jest": "^29.2.1",
    "@types/whatwg-fetch": "^0.0.33",
    "cli-progress": "^3.12.0",
    "colors": "^1.4.0",
    "cypress": "^14.4.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^13.4.0",
    "jest": "^29.4.3",
    "jest-environment-jsdom": "^29.4.3",
    "node-mocks-http": "^1.17.2",
    "ts-jest": "^29.0.5",
    "whatwg-fetch": "^3.6.20"
  }
}
